.vscode/**
.vscode-test/**
out/test/**
src/**
.gitignore
vsc-extension-quickstart.md
**/tsconfig.json
**/tslint.json
**/*.map
**/*.ts

# Agent and tooling state. vsce prunes node_modules only at the root, so a
# worktree checked out under .claude drags its whole dependency tree into the
# package: 8,653 files and 106 MB instead of 248 files and 1.1 MB.
.claude/**
.pi/**
.pi-lens/**
thoughts/**
**/*.vsix

# Codicons: the graph webview loads only the font and its stylesheet. The package
# also ships 640+ SVG sources and its build tooling, which triple the .vsix.
node_modules/@vscode/codicons/**
!node_modules/@vscode/codicons/dist/codicon.css
!node_modules/@vscode/codicons/dist/codicon.ttf
!node_modules/@vscode/codicons/LICENSE
!node_modules/@vscode/codicons/package.json
